#!/bin/zsh

# Source after filling in values (from repo root): `source tomj-lab/aws-env-secrets.sh`
#
# IAM Identity Center (SSO): run `aws sso login` when the CLI reports expired token.
# Example profile from `aws configure sso` (AdministratorAccess on account 925310216015):

# | Named profile for all AWS CLI / SDK calls (including eksctl if AWS_PROFILE is set) |
export AWS_PROFILE=foo

# | AWS account ID (from SSO account picker) |
export AWS_ACCOUNT_ID=foo

# | Region: use the same region as your EKS cluster (SSO default client region was us-east-2) |
export AWS_REGION=foo

# | EKS cluster name |
export EKS_CLUSTER_NAME=foo

# | Artifactory hostname (no https:// in Helm artifactoryUrl) |
export ARTIFACTORY_URL=foo

# | Artifactory user bound to JFROG_PULL_ROLE_ARN (create one binding per role ARN) |
export ARTIFACTORY_USER=foo

# | Kubernetes namespace for workload SA |
export NAMESPACE=foo

# | ServiceAccount name used by pods that pull from Artifactory |
export SERVICE_ACCOUNT_NAME=foo

export JFROG_PULL_ROLE_ARN=foo

# --- Cognito OIDC path only (if you use tomj-lab/examples/aws-cognito-oidc-values.yaml instead of IRSA) ---
# | Use a different Artifactory user than ARTIFACTORY_USER (IRSA / aws/iam_role binding) |
#export ARTIFACTORY_OIDC_USER=foo
#export COGNITO_USER_POOL_ID=foo
#export COGNITO_CLIENT_ID=foo
#export COGNITO_SECRET_NAME=foo
#export COGNITO_RESOURCE_SERVER_NAME=foo
#export COGNITO_RESOURCE_SCOPE=foo
#export JFROG_OIDC_PROVIDER_NAME=foo
