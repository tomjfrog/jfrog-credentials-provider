#!/bin/zsh
# Copy to azure-env-secrets.sh at repo root (gitignored), then: source azure-env-secrets.sh
# Option B (1.4.0): no Entra app registration required.

export TENANT_ID=ad8b5a8c-9862-4c41-a341-aa838fc564df
export SUBSCRIPTION_ID=1615f76b-5de0-4194-927e-53958b9da148
export RESOURCE_GROUP=tomj-jfrog-credentials-provider-lab-rg
export CLUSTER_NAME=tomj-k8s-cluster
export LOCATION=centralus

# From: az aks show ... --query oidcIssuerProfile.issuerUrl (exact string, trailing slash matters)
export SERVICE_ACCOUNT_ISSUER=https://centralus.oic.prod-aks.azure.com/ad8b5a8c-9862-4c41-a341-aa838fc564df/16d7b4c6-03c2-40d9-a137-354bd22d8bb6/

export ARTIFACTORY_URL=tomjpd2.jfrog.io
export OIDC_PROVIDER_NAME=aks-wi-lab-oidc

export TEAM_A_USER=aks-team-a-puller
export TEAM_B_USER=aks-team-b-puller
export TEAM_A_REPO=team-a-docker-local
export TEAM_B_REPO=team-b-docker-local
export LAB_IMAGE_TAG=wi-lab-amd64

# Projected token audience (must match Helm azure_app_audience and mapping claims.aud)
export AZURE_APP_AUDIENCE=jfrog-artifactory
# export AZURE_APP_AUDIENCE=api://AzureADTokenExchange  # fallback; requires legacy OIDC mappings
