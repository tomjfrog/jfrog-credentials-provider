#!/bin/zsh

# ` | Entra tenant |
export TENANT_ID=foo
# ` | Azure subscription |
export SUBSCRIPTION_ID=foo
# ` | AKS resource group |
export RESOURCE_GROUP=foo

#` | AKS name |
export CLUSTER_NAME=foo

#` | Azure region |
export LOCATION=foo

#` | App registration **application (client) ID** — same value you put on `azure.workload.identity/client-id` |
#export APP_CLIENT_ID=foo

#App registration object ID (Graph)
#export APP_OBJECT_ID=foo

# AKS OIDC issuer URL
export SERVICE_ACCOUNT_ISSUER=foo

# `your-instance.jfrog.io` (no `https://` in Helm `artifactoryUrl`)
#export ARTIFACTORY_URL=foo

# JFrog OIDC provider name (= `jfrog_oidc_provider_name` in Helm)
#export OIDC_PROVIDER_NAME=foo

# JFrog Artifactory user for a given mapping (often one per workload tier)
#export ARTIFACTORY_USER=foo

# Kubernetes namespace for the workload SA (repeat per workload as needed)
#export NAMESPACE=foo

# Name of the SA that **pods pulling from Artifactory** use
#export SERVICE_ACCOUNT_NAME=foo
